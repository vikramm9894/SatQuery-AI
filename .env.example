# ==============================================================================
# SatQuery AI — Enterprise Environment Configuration (.env.example)
# Smart India Hackathon / ISRO Problem Statement SIH26167
# ==============================================================================

# Project & Service Info
PROJECT_NAME="SatQuery AI"
VERSION="3.0.0"
DEBUG=false
ENVIRONMENT="production"

# Server Host & Port
HOST="0.0.0.0"
PORT=8000
WORKERS=4

# Security & Cryptographic Signing
SECRET_KEY="replace-this-with-a-cryptographically-secure-random-key"
SESSION_TTL_HOURS=4
MAX_FILE_SIZE_BYTES=262144000      # 250 MB
MAX_SESSION_SIZE_BYTES=524288000   # 500 MB

# Hardware & Acceleration
ALLOW_GPU=true
ONNX_EXECUTION_PROVIDER="CUDAExecutionProvider,CPUExecutionProvider"
TORCH_DEVICE="cuda"

# Geospatial Coordinates & Defaults
DEFAULT_CRS="EPSG:4326"
TARGET_OPTICAL_RES_M=0.65          # Cartosat-2S native GSD (meters)

# Storage & Database Backends
STORAGE_ROOT="storage"
DATABASE_URL="sqlite:///storage/satquery.db"
# DATABASE_URL="postgresql://satquery:securepassword@postgres:5432/satquery_db"
REDIS_URL="redis://redis:6379/0"

# Optional Cloud Providers & Live Satellite APIs (Leave empty for Offline Deterministic Mode)
BHUVAN_API_KEY=""
SENTINEL_HUB_CLIENT_ID=""
SENTINEL_HUB_CLIENT_SECRET=""
NASA_EARTHDATA_TOKEN=""

# Multimodal LLM / VLM API Providers (Optional - platform falls back to offline deterministic specialist agents)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""
VLM_PROVIDER="deterministic"      # "deterministic" | "openai" | "gemini" | "huggingface"

# Agent & Verification Settings
VLM_FEATURE_ENABLED=true
VLM_FUSION_STRATEGY="gated"
VLM_CONFIDENCE_THRESHOLD=0.70
VLM_SUPPRESS_SPECKLE=true
VLM_CIRCUIT_BREAKER_MAX_ERRORS=5
VLM_GATE_DEFAULT=0.50
HONEST_ABSTENTION_THRESHOLD=0.40
